{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faric.local/schemas/account.schema.json",
  "title": "FARIC Music Graph account document",
  "type": "object",
  "required": ["schemaVersion", "authDataIncluded", "accounts", "relationships"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"type": "string"},
    "authDataIncluded": {"const": false},
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "displayName", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "externalAccountId": {"type": ["string", "null"]},
          "displayName": {"type": "string", "minLength": 1},
          "handle": {"type": ["string", "null"]},
          "publicUrl": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "lastInventoryAt": {"type": ["string", "null"]},
          "fixtureOnly": {"type": "boolean"},
          "provenance": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "fixtureOnly": {"type": "boolean"},
          "provenance": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
